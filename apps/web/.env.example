NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
OPENAI_API_KEY=sk-your-openai-key

# apps/server WebSocket endpoint. Defaults to ws://localhost:3001/ws when unset
# (local dev). Set to your deployed Render URL for production, e.g.
# wss://your-server.onrender.com/ws
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws

# apps/server REST API base URL (metrics/logs history). Defaults to
# http://localhost:3001 when unset (local dev). Set to your deployed Render
# URL for production, e.g. https://your-server.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:3001
