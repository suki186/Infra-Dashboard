# Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"

# Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://user:password@host:5432/postgres"

PORT=3001

# Comma-separated list of extra origins allowed to call this API,
# in addition to http://localhost:3000 which is always allowed.
# e.g. your Vercel production + preview domains.
ALLOWED_ORIGIN="https://your-app.vercel.app"

# if you want to run the real simulator.mjs against your dev server instead.
DEMO_MODE=true

# Only used when DEMO_MODE=true. Rows in infrastructure_metrics/infrastructure_logs
# older than this many hours are deleted every 10 minutes, so the demo data
# generator doesn't grow the DB unbounded. Defaults to 24 when unset.
DATA_RETENTION_HOURS=24
